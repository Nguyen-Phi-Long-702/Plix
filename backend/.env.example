SUPABASE_URL=https://<project-ref>.supabase.co
DATABASE_URL=postgresql://postgres.<project-ref>:<mat-khau>@<pooler-host>:5432/postgres
#Mặc định 3600s nếu không khai báo. Số giây tối thiểu giữa 2 lần gọi /retrain thành công của cùng 1 user.
RETRAIN_COOLDOWN_SECONDS=3600
#Mặc định 500 nếu không khai báo. Số bản ghi tối đa mỗi lần gọi GET /sync/{table}/pull; limit client gửi lớn hơn sẽ bị cắt về mức này.
MAX_PULL_LIMIT=500