<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Thang chữ (Design System > Type scale) ===== -->
    <style name="TextAppearance.Plix.AmountLarge" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">@font/be_vietnam_pro_extrabold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Số liệu nổi bật trong thẻ (dự báo, tỷ lệ tiết kiệm) -->
    <style name="TextAppearance.Plix.AmountMedium" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">@font/be_vietnam_pro_extrabold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Chữ liên kết bấm được (Đăng ký ngay, Đăng nhập, Xem tất cả); vùng chạm tối thiểu theo token touch_target_min -->
    <style name="Widget.Plix.TextLink" parent="">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:paddingHorizontal">@dimen/spacing_8</item>
        <item name="android:textAppearance">@style/TextAppearance.Plix.Label</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- Tên thương hiệu trên màn Đăng nhập (CSS: 24 / 800) -->
    <style name="TextAppearance.Plix.BrandName" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">@font/be_vietnam_pro_extrabold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Plix.AppBarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/be_vietnam_pro_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Plix.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/be_vietnam_pro_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Plix.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/be_vietnam_pro_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Plix.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/be_vietnam_pro_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Nhãn ô nhập, chữ trên chip (CSS: 12.5 / 700) -->
    <style name="TextAppearance.Plix.Label" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/be_vietnam_pro_bold</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Chữ trên nút (CSS: 15 / 700, không viết hoa toàn bộ) -->
    <style name="TextAppearance.Plix.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/be_vietnam_pro_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- ===== Hình dạng ===== -->
    <style name="ShapeAppearanceOverlay.Plix.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.Plix.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <!-- ===== Thanh ActionBar ===== -->
    <style name="Widget.Plix.ActionBar" parent="Widget.MaterialComponents.ActionBar.Surface">
        <item name="background">@color/surface</item>
        <item name="titleTextStyle">@style/TextAppearance.Plix.AppBarTitle</item>
    </style>

    <!-- ===== Thẻ ===== -->
    <style name="Widget.Plix.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/radius_medium</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ===== Nút ===== -->
    <style name="Widget.Plix.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Plix.Button</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
    </style>

    <style name="Widget.Plix.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Plix.Button</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <style name="Widget.Plix.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Plix.Button</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
    </style>

    <style name="Widget.Plix.Button.Danger" parent="Widget.Plix.Button">
        <item name="backgroundTint">@color/budget_progress_danger</item>
    </style>

    <!-- ===== Ô nhập ===== -->
    <style name="Widget.Plix.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_small</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_small</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_small</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_small</item>
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.Plix.Hint</item>
    </style>

    <!-- ===== Chip ===== -->
    <style name="Widget.Plix.Chip.Choice" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:textAppearance">@style/TextAppearance.Plix.Label</item>
        <item name="android:textColor">@color/selector_chip_text</item>
        <item name="chipBackgroundColor">@color/selector_chip_background</item>
        <item name="chipStrokeColor">@color/selector_chip_stroke</item>
        <item name="chipStrokeWidth">1.5dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Plix.Pill</item>
    </style>

    <!-- ===== Hộp thoại (MaterialAlertDialogBuilder) ===== -->
    <style name="ThemeOverlay.Plix.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Plix</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Plix.Title.Text</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.Plix.Body.Text</item>
    </style>

    <style name="MaterialAlertDialog.Plix" parent="MaterialAlertDialog.MaterialComponents">
        <item name="shapeAppearance">@style/ShapeAppearance.Plix.Dialog</item>
        <item name="shapeAppearanceOverlay">@null</item>
    </style>

    <style name="MaterialAlertDialog.Plix.Title.Text" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:fontFamily">@font/be_vietnam_pro_extrabold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="MaterialAlertDialog.Plix.Body.Text" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ===== Chọn ngày (dùng cho DatePickerDialog) ===== -->
    <style name="Theme.Plix.DatePicker" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/primary</item>
    </style>

    <!-- ===== Form Thêm/Sửa giao dịch ===== -->
    <!-- Ô số tiền lớn và hậu tố "đ" -->
    <style name="TextAppearance.Plix.AmountInput" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">@font/be_vietnam_pro_extrabold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Plix.AmountSuffix" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/be_vietnam_pro_bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Chữ trong banner -->
    <style name="TextAppearance.Plix.BodySmall" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/be_vietnam_pro_regular</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Dòng gợi ý dưới ô nhập -->
    <style name="TextAppearance.Plix.Hint" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/be_vietnam_pro_regular</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Tiêu đề bottom sheet -->
    <style name="TextAppearance.Plix.SheetTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/be_vietnam_pro_extrabold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Công tắc Chi tiêu / Thu nhập: viền chung, màu khi chọn do selector quyết định -->
    <style name="Widget.Plix.Button.Segment" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Plix.Button</item>
        <item name="cornerRadius">@dimen/radius_small</item>
        <item name="strokeColor">@color/border_strong</item>
        <item name="strokeWidth">@dimen/segment_stroke_width</item>
    </style>

    <style name="Widget.Plix.Button.Segment.Expense" parent="Widget.Plix.Button.Segment">
        <item name="backgroundTint">@color/selector_segment_expense_background</item>
        <item name="android:textColor">@color/selector_segment_expense_text</item>
    </style>

    <style name="Widget.Plix.Button.Segment.Income" parent="Widget.Plix.Button.Segment">
        <item name="backgroundTint">@color/selector_segment_income_background</item>
        <item name="android:textColor">@color/selector_segment_income_text</item>
    </style>

    <!-- Chip hành động (Bỏ qua, Thử lại) và biến thể nền primary (Dùng gợi ý) -->
    <style name="Widget.Plix.Chip.Action" parent="Widget.MaterialComponents.Chip.Action">
        <item name="android:textAppearance">@style/TextAppearance.Plix.Label</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="chipBackgroundColor">@color/surface</item>
        <item name="chipStrokeColor">@color/border_strong</item>
        <item name="chipStrokeWidth">1.5dp</item>
        <item name="chipIconTint">@color/text_secondary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Plix.Pill</item>
    </style>

    <style name="Widget.Plix.Chip.Action.Primary" parent="Widget.Plix.Chip.Action">
        <item name="android:textColor">@color/white</item>
        <item name="chipBackgroundColor">@color/primary</item>
        <item name="chipStrokeColor">@color/primary</item>
        <item name="chipIconTint">@color/white</item>
    </style>

    <!-- Công tắc: thumb trắng, track primary khi bật -->
    <style name="Widget.Plix.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/white</item>
        <item name="trackTint">@color/selector_switch_track</item>
    </style>

    <!-- ===== Bottom sheet (BottomSheetDialog): bo góc trên theo radius_large ===== -->
    <style name="ThemeOverlay.Plix.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Plix.BottomSheet</item>
    </style>

    <style name="Widget.Plix.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Plix.BottomSheet</item>
    </style>

    <style name="ShapeAppearanceOverlay.Plix.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_large</item>
        <item name="cornerSizeTopRight">@dimen/radius_large</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ===== Thanh chuyển Ngân sách / Mục tiêu: tab đang chọn (state_selected) nền trắng, chữ primary ===== -->
    <style name="Widget.Plix.Button.SegmentTab" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Plix.Label</item>
        <item name="android:textColor">@color/selector_tab_text</item>
        <item name="backgroundTint">@color/selector_tab_background</item>
        <item name="cornerRadius">@dimen/segment_tab_radius</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/spacing_4</item>
        <item name="iconSize">@dimen/segment_tab_icon_size</item>
        <item name="iconTint">@color/selector_tab_text</item>
    </style>

    <!-- ===== FAB đơn (Ngân sách, Mục tiêu): bo góc theo radius_large như FAB mở rộng ===== -->
    <style name="ShapeAppearanceOverlay.Plix.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_large</item>
    </style>

    <style name="Widget.Plix.FloatingActionButton" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Plix.Fab</item>
    </style>

    <!-- Công tắc 2 lựa chọn trung tính (Phạm vi ngân sách): chọn thì nền primary_tint, chữ primary_dark -->
    <style name="Widget.Plix.Button.Segment.Primary" parent="Widget.Plix.Button.Segment">
        <item name="backgroundTint">@color/selector_segment_primary_background</item>
        <item name="android:textColor">@color/selector_segment_primary_text</item>
    </style>
</resources>