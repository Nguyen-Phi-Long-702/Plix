<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Giao diện sáng duy nhất của Plix (NF-08: không có chế độ tối) -->
    <style name="Theme.Plix" parent="Theme.MaterialComponents.Light">
        <!-- Màu thương hiệu -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSecondaryVariant">@color/primary_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Nền, bề mặt, chữ -->
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/budget_progress_danger</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>

        <!-- Thanh trạng thái sáng, không cho hệ thống tự đảo màu -->
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>

        <!-- Font Be Vietnam Pro và các mức chữ của Material -->
        <item name="android:fontFamily">@font/be_vietnam_pro_regular</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.Plix.AppBarTitle</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.Plix.Body</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Plix.Body</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Plix.Body</item>
        <item name="textAppearanceCaption">@style/TextAppearance.Plix.Caption</item>
        <item name="textAppearanceButton">@style/TextAppearance.Plix.Button</item>

        <!-- ActionBar và hộp thoại -->
        <item name="actionBarStyle">@style/Widget.Plix.ActionBar</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Plix.BottomSheetDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Plix.MaterialAlertDialog</item>
        <item name="android:datePickerDialogTheme">@style/Theme.Plix.DatePicker</item>
    </style>
</resources>