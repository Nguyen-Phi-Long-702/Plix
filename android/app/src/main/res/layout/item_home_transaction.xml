<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_12">

        <ImageView
            android:id="@+id/imageCategoryIcon"
            android:layout_width="@dimen/home_category_tile_size"
            android:layout_height="@dimen/home_category_tile_size"
            android:background="@drawable/bg_home_category_tile"
            android:importantForAccessibility="no"
            android:padding="@dimen/spacing_12"
            tools:src="@drawable/ic_food" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textCategoryName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Plix.SectionTitle"
                tools:text="Ăn uống" />

            <TextView
                android:id="@+id/textNoteAndDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Plix.Caption"
                tools:text="Ăn trưa văn phòng · 14/09/2026" />
        </LinearLayout>

        <TextView
            android:id="@+id/textAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12"
            android:textAppearance="@style/TextAppearance.Plix.SectionTitle"
            tools:text="-50.000đ" />
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/viewDivider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:dividerColor="@color/border" />
</LinearLayout>