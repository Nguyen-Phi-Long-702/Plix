<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingTop="@dimen/spacing_32"
        android:paddingBottom="@dimen/spacing_16">

        <!-- Logo, tên ứng dụng, câu mô tả ngắn (cùng kiểu với màn Đăng nhập) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_24"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Plix.Card"
                android:layout_width="@dimen/auth_logo_size"
                android:layout_height="@dimen/auth_logo_size"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="@dimen/spacing_8"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo_plix" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:text="Plix"
                android:textAppearance="@style/TextAppearance.Plix.BrandName" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="Quản lý chi tiêu cá nhân ứng dụng AI"
                android:textAppearance="@style/TextAppearance.Plix.Caption" />
        </LinearLayout>

        <!-- Thẻ thông tin -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Plix.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_16">

                <!-- Đồ án -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_12">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Đồ án"
                        android:textAppearance="@style/TextAppearance.Plix.Caption" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:text="Ứng dụng Android quản lý chi tiêu cá nhân, ứng dụng trí tuệ nhân tạo"
                        android:textAppearance="@style/TextAppearance.Plix.SectionTitle" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerColor="@color/border" />

                <!-- Sinh viên thực hiện -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_12">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sinh viên thực hiện"
                        android:textAppearance="@style/TextAppearance.Plix.Caption" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:text="Nguyễn Phi Long (24521007)\nNguyễn Đại Vương (24522050)"
                        android:textAppearance="@style/TextAppearance.Plix.SectionTitle" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerColor="@color/border" />

                <!-- Giảng viên hướng dẫn -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_12">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Giảng viên hướng dẫn"
                        android:textAppearance="@style/TextAppearance.Plix.Caption" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:text="Ths.Võ Tuấn Kiệt"
                        android:textAppearance="@style/TextAppearance.Plix.SectionTitle" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerColor="@color/border" />

                <!-- Kho mã nguồn: bấm để mở trình duyệt -->
                <LinearLayout
                    android:id="@+id/rowGithub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target_min"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/spacing_12">

                    <FrameLayout
                        android:layout_width="@dimen/sheet_option_icon_box_size"
                        android:layout_height="@dimen/sheet_option_icon_box_size"
                        android:background="@drawable/bg_sheet_option_icon">

                        <ImageView
                            android:layout_width="@dimen/sheet_option_icon_size"
                            android:layout_height="@dimen/sheet_option_icon_size"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_github"
                            app:tint="@color/text_secondary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/textGithubLink"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_12"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Plix.SectionTitle"
                        android:textColor="@color/primary" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerColor="@color/border" />

                <!-- Phiên bản -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_12">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Phiên bản"
                        android:textAppearance="@style/TextAppearance.Plix.Caption" />

                    <TextView
                        android:id="@+id/textAboutVersion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:textAppearance="@style/TextAppearance.Plix.SectionTitle" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>