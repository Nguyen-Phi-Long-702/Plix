<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/partial_budget_goal_tabs" />

        <TextView
            android:id="@+id/textBudgetPeriod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_16"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginBottom="@dimen/spacing_8"
            android:textAppearance="@style/TextAppearance.Plix.Label"
            android:visibility="gone"
            tools:text="Kỳ: Tháng 10/2026"
            tools:visibility="visible" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerBudgets"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/budget_goal_list_padding_bottom"
                tools:listitem="@layout/item_budget" />

            <LinearLayout
                android:id="@+id/layoutStateLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/spacing_12"
                android:visibility="gone">

                <include layout="@layout/item_skeleton_card" />

                <include layout="@layout/item_skeleton_card" />

                <include layout="@layout/item_skeleton_card" />
            </LinearLayout>

            <com.longvuong.plix.presentation.common.EmptyStateView
                android:id="@+id/viewEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                app:emptyActionText="Tạo ngân sách"
                app:emptyIcon="@drawable/ic_wallet"
                app:emptyMessage="Tạo ngân sách đầu tiên để theo dõi chi tiêu theo tháng."
                app:emptyTitle="Chưa có ngân sách" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddBudget"
        style="@style/Widget.Plix.FloatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/spacing_16"
        android:contentDescription="Thêm ngân sách"
        app:srcCompat="@drawable/ic_plus" />
</FrameLayout>