<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.button.MaterialButtonToggleGroup xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toggleBudgetGoal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:singleSelection="true"
    app:selectionRequired="true">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTabBudget"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:minHeight="48dp"
        android:text="Ngân sách" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTabGoal"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:minHeight="48dp"
        android:text="Mục tiêu" />

</com.google.android.material.button.MaterialButtonToggleGroup>