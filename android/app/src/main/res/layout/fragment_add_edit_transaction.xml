<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">

        <LinearLayout
            android:id="@+id/layoutAnomalyChecking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_16"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="@dimen/spacing_20"
                android:layout_height="@dimen/spacing_20"
                android:layout_marginEnd="@dimen/spacing_8" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Đang kiểm tra mức chi tiêu..."
                android:textAppearance="@style/TextAppearance.Plix.Caption" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutAnomalyBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_16"
            android:background="@drawable/bg_anomaly_banner"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_12"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imageAnomalyIcon"
                android:layout_width="@dimen/banner_icon_size"
                android:layout_height="@dimen/banner_icon_size"
                android:layout_marginEnd="@dimen/spacing_12"
                android:importantForAccessibility="no"
                app:tint="@color/warn_strong"
                tools:src="@drawable/ic_anomaly_high" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textAnomalyTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Plix.Label"
                    android:textColor="@color/warn_strong"
                    tools:text="Chi tiêu cao bất thường" />

                <TextView
                    android:id="@+id/textAnomalyExplanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:textAppearance="@style/TextAppearance.Plix.BodySmall"
                    android:textColor="@color/warn_strong"
                    tools:text="Giao dịch này cao hơn mức chi tiêu trung bình cho danh mục Ăn uống của bạn (trung bình 45.000đ, giao dịch này 350.000đ)" />

                <TextView
                    android:id="@+id/textAnomalyPendingNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:alpha="0.8"
                    android:text="Kết quả có thể chưa tính giao dịch mới nhất đang chờ đồng bộ"
                    android:textAppearance="@style/TextAppearance.Plix.BodySmall"
                    android:textColor="@color/warn_strong"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutAnomalyInsufficient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_16"
            android:background="@drawable/bg_anomaly_info"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_12"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/banner_icon_size"
                android:layout_height="@dimen/banner_icon_size"
                android:layout_marginEnd="@dimen/spacing_12"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_anomaly_insufficient"
                app:tint="@color/info_text" />

            <TextView
                android:id="@+id/textAnomalyInsufficient"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Plix.BodySmall"
                android:textColor="@color/info_text"
                tools:text="Danh mục này chưa có đủ giao dịch để Plix nhận diện bất thường (cần tối thiểu 5 giao dịch). Cứ tiếp tục ghi chép — tính năng sẽ tự bật khi có đủ dữ liệu." />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutAutoGeneratedBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_16"
            android:background="@drawable/bg_anomaly_info"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_12"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/banner_icon_size"
                android:layout_height="@dimen/banner_icon_size"
                android:layout_marginEnd="@dimen/spacing_12"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_repeat"
                app:tint="@color/info_text" />

            <TextView
                android:id="@+id/textAutoGenerated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Plix.BodySmall"
                android:textColor="@color/info_text"
                tools:text="Giao dịch này được Plix tự động tạo từ giao dịch định kỳ &quot;Tiền nhà tháng 9&quot;. Sửa hoặc xoá chỉ ảnh hưởng riêng kỳ này — các kỳ khác không thay đổi." />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loại giao dịch"
            android:textAppearance="@style/TextAppearance.Plix.Label" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExpense"
                style="@style/Widget.Plix.Button.Segment.Expense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chi tiêu" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIncome"
                style="@style/Widget.Plix.Button.Segment.Income"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Thu nhập" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="Số tiền"
            android:textAppearance="@style/TextAppearance.Plix.Label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutAmount"
            style="@style/Widget.Plix.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            app:helperText="Số tiền phải lớn hơn 0, tối đa 999.999.999.999đ (999 tỷ — tránh tràn số)."
            app:hintEnabled="false"
            app:suffixText="đ"
            app:suffixTextAppearance="@style/TextAppearance.Plix.AmountSuffix">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789."
                android:hint="0"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="17"
                android:textAppearance="@style/TextAppearance.Plix.AmountInput" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/layoutSimilarWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:background="@drawable/bg_anomaly_banner"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_12"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/banner_icon_size"
                android:layout_height="@dimen/banner_icon_size"
                android:layout_marginEnd="@dimen/spacing_12"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info"
                app:tint="@color/warn_strong" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textSimilarTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Plix.Label"
                    android:textColor="@color/warn_strong"
                    tools:text="Giao dịch tương tự đã tồn tại" />

                <TextView
                    android:id="@+id/textSimilarDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:textAppearance="@style/TextAppearance.Plix.BodySmall"
                    android:textColor="@color/warn_strong"
                    tools:text="Bạn đã ghi 45.000đ cho Ăn uống vào ngày 29/10/2026. Vẫn có thể lưu thêm nếu đây là giao dịch thật khác." />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="Danh mục"
            android:textAppearance="@style/TextAppearance.Plix.Label" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="Ngày giao dịch"
            android:textAppearance="@style/TextAppearance.Plix.Label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutDate"
            style="@style/Widget.Plix.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            app:endIconContentDescription="Chọn ngày"
            app:endIconDrawable="@drawable/ic_chev_down"
            app:endIconMode="custom"
            app:endIconTint="@color/text_tertiary"
            app:helperText="Không chọn quá xa tương lai (tối đa cuối năm nay) hoặc quá khứ (không quá 5 năm trước)."
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_calendar"
            app:startIconTint="@color/text_tertiary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:cursorVisible="false"
                android:focusable="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="Phương thức thanh toán"
            android:textAppearance="@style/TextAppearance.Plix.Label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutPaymentMethod"
            style="@style/Widget.Plix.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            app:endIconContentDescription="Chọn phương thức thanh toán"
            app:endIconDrawable="@drawable/ic_chev_down"
            app:endIconMode="custom"
            app:endIconTint="@color/text_tertiary"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_wallet"
            app:startIconTint="@color/text_tertiary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:cursorVisible="false"
                android:focusable="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="Ghi chú"
            android:textAppearance="@style/TextAppearance.Plix.Label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutNote"
            style="@style/Widget.Plix.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            app:counterEnabled="true"
            app:counterMaxLength="500"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="vd: cà phê highlands, ăn trưa..."
                android:imeOptions="actionDone"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/layoutCategorySuggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:background="@drawable/bg_ai_box"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_12"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="@dimen/ai_box_icon_box_size"
                android:layout_height="@dimen/ai_box_icon_box_size"
                android:layout_marginEnd="@dimen/spacing_12"
                android:background="@drawable/bg_ai_box_icon">

                <ImageView
                    android:id="@+id/imageSuggestionIcon"
                    android:layout_width="@dimen/ai_box_icon_size"
                    android:layout_height="@dimen/ai_box_icon_size"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkle"
                    app:tint="@color/primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textSuggestionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Plix.Label"
                    android:textColor="@color/text_primary"
                    tools:text="Gợi ý: Ăn uống" />

                <TextView
                    android:id="@+id/textSuggestionDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:textAppearance="@style/TextAppearance.Plix.Caption"
                    tools:text="Độ tin cậy tương đối: 82%" />

                <LinearLayout
                    android:id="@+id/layoutSuggestionActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipUseSuggestion"
                        style="@style/Widget.Plix.Chip.Action.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_8"
                        android:text="Dùng gợi ý"
                        app:chipIcon="@drawable/ic_check"
                        app:chipIconSize="@dimen/filter_chip_icon_size"
                        app:chipIconVisible="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDismissSuggestion"
                        style="@style/Widget.Plix.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bỏ qua" />
                </LinearLayout>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRetryCategorize"
                    style="@style/Widget.Plix.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:text="Thử lại"
                    android:visibility="gone"
                    app:chipIcon="@drawable/ic_refresh"
                    app:chipIconSize="@dimen/filter_chip_icon_size"
                    app:chipIconVisible="true" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutRecurring"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giao dịch định kỳ"
                        android:textAppearance="@style/TextAppearance.Plix.Label" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tự động lặp lại hằng tháng"
                        android:textAppearance="@style/TextAppearance.Plix.Hint" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchRecurring"
                    style="@style/Widget.Plix.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Giao dịch định kỳ" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutRecurringDay"
                style="@style/Widget.Plix.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:visibility="gone"
                app:endIconContentDescription="Chọn ngày lặp lại"
                app:endIconDrawable="@drawable/ic_chev_down"
                app:endIconMode="custom"
                app:endIconTint="@color/text_tertiary"
                app:helperText="Sửa ngày lặp lại chỉ áp dụng cho các kỳ được tạo sau khi lưu; các giao dịch đã tạo trước đó giữ nguyên."
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_repeat"
                app:startIconTint="@color/text_tertiary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editRecurringDay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSave"
            style="@style/Widget.Plix.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="Lưu giao dịch"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart" />
    </LinearLayout>
</ScrollView>