<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_24">
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayoutCategoryName"
        style="@style/Widget.Plix.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_16"
        android:hint="Tên danh mục"
        app:helperText="Tối đa 50 ký tự. Trùng tên với danh mục hệ thống cùng loại sẽ bị từ chối khi lưu."
        app:helperTextEnabled="true"
        app:placeholderText="vd: Nuôi thú cưng">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editCategoryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLength="50" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_8"
        android:text="Loại"
        android:textAppearance="@style/TextAppearance.Plix.Label" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleCategoryType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCategoryExpense"
            style="@style/Widget.Plix.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chi tiêu"
            android:textColor="@color/selector_category_type_expense_text"
            app:backgroundTint="@color/selector_category_type_expense_background"
            app:cornerRadius="@dimen/radius_small"
            app:strokeColor="@color/border_strong" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCategoryIncome"
            style="@style/Widget.Plix.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thu nhập"
            android:textColor="@color/selector_category_type_income_text"
            app:backgroundTint="@color/selector_category_type_income_background"
            app:cornerRadius="@dimen/radius_small"
            app:strokeColor="@color/border_strong" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>