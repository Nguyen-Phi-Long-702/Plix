<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_24">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Số tiền"
        android:textAppearance="@style/TextAppearance.Plix.Label" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayoutSuggestionAmount"
        style="@style/Widget.Plix.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:layout_marginBottom="@dimen/spacing_16"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editSuggestionAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0"
            android:imeOptions="actionDone"
            android:inputType="number" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Danh mục"
        android:textAppearance="@style/TextAppearance.Plix.Label" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayoutSuggestionCategory"
        style="@style/Widget.Plix.TextInputLayout.Dropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        app:hintEnabled="false"
        app:startIconContentDescription="Danh mục"
        app:startIconDrawable="@drawable/ic_tag">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/editSuggestionCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Chọn danh mục"
            android:inputType="none" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>