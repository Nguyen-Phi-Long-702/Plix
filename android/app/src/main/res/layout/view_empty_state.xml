<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/spacing_32">

    <ImageView
        android:id="@+id/imageEmptyIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_empty_icon"
        android:importantForAccessibility="no"
        android:padding="@dimen/spacing_16"
        android:tint="@color/text_tertiary" />

    <TextView
        android:id="@+id/textEmptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Plix.SectionTitle" />

    <TextView
        android:id="@+id/textEmptyMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:textAppearance="@style/TextAppearance.Plix.Caption" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonEmptyAction"
        style="@style/Widget.Plix.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:paddingHorizontal="@dimen/spacing_20"
        android:visibility="gone"
        app:icon="@drawable/ic_plus"
        app:iconTint="@color/white" />
</LinearLayout>