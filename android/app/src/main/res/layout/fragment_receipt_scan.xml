<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quét hoá đơn"
            android:textAppearance="@style/TextAppearance.Plix.SectionTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:lineSpacingMultiplier="1.3"
            android:text="Chụp hoặc chọn ảnh hoá đơn, Plix sẽ điền sẵn số tiền, ngày và tên cửa hàng để bạn kiểm tra"
            android:textAppearance="@style/TextAppearance.Plix.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCapture"
            style="@style/Widget.Plix.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="Chụp ảnh" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPickGallery"
            style="@style/Widget.Plix.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="Chọn từ thư viện" />

        <TextView
            android:id="@+id/textScanPrivacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:lineSpacingMultiplier="1.3"
            android:text="Ảnh chỉ được đọc trên máy của bạn và không được gửi đi"
            android:textAppearance="@style/TextAppearance.Plix.Caption" />

        <LinearLayout
            android:id="@+id/layoutScanLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đang đọc hoá đơn"
                android:textAppearance="@style/TextAppearance.Plix.SectionTitle" />

            <include layout="@layout/layout_state_loading" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutScanError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/textScanError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Plix.Caption"
                android:textColor="?attr/colorError" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEnterManually"
                style="@style/Widget.Plix.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="Nhập tay" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>