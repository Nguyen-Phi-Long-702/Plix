<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhập nhanh bằng câu tự nhiên"
                android:textAppearance="@style/TextAppearance.Plix.Label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutQuickText"
                style="@style/Widget.Plix.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editQuickText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:hint="vd: ăn sáng 30k, đổ xăng 50 nghìn, lương tháng này 12 triệu"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="Mỗi câu tách bởi dấu phẩy hoặc “và”/“rồi” sẽ được nhận diện thành 1 giao dịch riêng."
                android:textAppearance="@style/TextAppearance.Plix.Caption"
                android:textColor="@color/text_tertiary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonAnalyze"
                style="@style/Widget.Plix.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="Phân tích bằng AI"
                app:icon="@drawable/ic_sparkle"
                app:iconGravity="textStart"
                app:iconSize="@dimen/inline_icon_size" />

            <LinearLayout
                android:id="@+id/layoutAiBusy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_anomaly_banner"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_12">

                    <ImageView
                        android:layout_width="@dimen/inline_icon_size"
                        android:layout_height="@dimen/inline_icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/warn_strong" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="AI đang bận, vui lòng nhập tay."
                            android:textAppearance="@style/TextAppearance.Plix.Label"
                            android:textColor="@color/warn_strong" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_4"
                            android:lineSpacingMultiplier="1.3"
                            android:text="Câu quá phức tạp để bộ phân tích tự viết xử lý, và dịch vụ dự phòng Gemini hiện đang quá tải hoặc đã hết hạn mức miễn phí trong ngày."
                            android:textAppearance="@style/TextAppearance.Plix.Caption"
                            android:textColor="@color/warn_strong" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonEnterManually"
                    style="@style/Widget.Plix.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:text="Nhập từng giao dịch thủ công"
                    app:icon="@drawable/ic_plus"
                    app:iconGravity="textStart"
                    app:iconSize="@dimen/inline_icon_size"
                    app:iconTint="@color/white" />
            </LinearLayout>

            <TextView
                android:id="@+id/textError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:textAppearance="@style/TextAppearance.Plix.Caption"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textEmptyResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:lineSpacingMultiplier="1.3"
                android:text="Không nhận diện được giao dịch nào trong câu này. Hãy thử ghi rõ số tiền, vd “phở 50k”, hoặc nhập giao dịch thủ công."
                android:textAppearance="@style/TextAppearance.Plix.Caption"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutParsing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kết quả nhận diện"
                    android:textAppearance="@style/TextAppearance.Plix.SectionTitle" />

                <include layout="@layout/layout_state_loading" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textResultTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_8"
                    android:textAppearance="@style/TextAppearance.Plix.SectionTitle"
                    tools:text="Kết quả nhận diện (2)" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerSuggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSaveSuggestions"
                    style="@style/Widget.Plix.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:text="Lưu giao dịch"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconSize="@dimen/inline_icon_size"
                    app:iconTint="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutPrivacyInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:background="@drawable/bg_anomaly_info"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_12">

                <ImageView
                    android:layout_width="@dimen/inline_icon_size"
                    android:layout_height="@dimen/inline_icon_size"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_12"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.3"
                    android:text="Tính năng cần có mạng để phân tích câu chữ. Bạn có thể tắt trong Cài đặt → AI &amp; Quyền riêng tư."
                    android:textAppearance="@style/TextAppearance.Plix.Caption" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.longvuong.plix.presentation.common.EmptyStateView
        android:id="@+id/viewOfflineState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="@dimen/spacing_32"
        android:visibility="gone"
        app:emptyActionText="Thêm giao dịch thủ công"
        app:emptyIcon="@drawable/ic_info"
        app:emptyMessage="Nhập nhanh bằng AI cần gọi máy chủ để phân tích câu chữ. Hãy nối mạng, hoặc nhập giao dịch thủ công."
        app:emptyTitle="Cần có kết nối mạng" />
</FrameLayout>