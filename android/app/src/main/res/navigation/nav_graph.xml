<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/authGraph">

    <navigation
        android:id="@+id/authGraph"
        app:startDestination="@id/loginFragment">

        <fragment
            android:id="@+id/loginFragment"
            android:name="com.longvuong.plix.presentation.auth.LoginFragment"
            android:label="Đăng nhập"
            tools:layout="@layout/fragment_login">
            <action
                android:id="@+id/action_login_to_register"
                app:destination="@id/registerFragment" />
        </fragment>

        <fragment
            android:id="@+id/registerFragment"
            android:name="com.longvuong.plix.presentation.auth.RegisterFragment"
            android:label="Đăng ký"
            tools:layout="@layout/fragment_register">
            <action
                android:id="@+id/action_register_to_login"
                app:destination="@id/loginFragment" />
        </fragment>

    </navigation>

    <navigation
        android:id="@+id/mainGraph"
        app:startDestination="@id/placeholderMainFragment">
        <fragment
            android:id="@+id/placeholderMainFragment"
            android:name="com.longvuong.plix.presentation.common.PlaceholderMainFragment"
            android:label="Trang chủ (placeholder)" />
    </navigation>

</navigation>